{
  "name": "@local/clipboard-history",
  "version": "1.1.0",
  "type": "module",
  "description": "Searchable clipboard history for DeepSeek Harness: records text copied in the Web app and, on Windows, text copied in other applications while DSH runs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/z-axk/dsh-clipboard-history.git"
  },
  "homepage": "https://github.com/z-axk/dsh-clipboard-history#readme",
  "bugs": {
    "url": "https://github.com/z-axk/dsh-clipboard-history/issues"
  },
  "keywords": [
    "dsh-plugin",
    "clipboard",
    "clipboard-history",
    "productivity"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/en.json",
    "locale/zh.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
